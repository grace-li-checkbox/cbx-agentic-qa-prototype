{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--browser", "chromium",
        "--viewport-size", "1280x800",
        "--caps", "devtools",
        "--storage-state", "/tmp/qa-run/state.json",
        "--output-dir", "/tmp/qa-run"
      ]
    }
  }
}
